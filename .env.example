PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=            # merchant sandbox REST app
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
AGENT_PLATFORM_CLIENT_ID=    # second sandbox business account's REST app (pays agent-fault payouts)
AGENT_PLATFORM_CLIENT_SECRET=
AGENT_PLATFORM_WEBHOOK_ID=   # webhook on the agent-platform app (PAYMENT.PAYOUTS* events)
POOL_BUYER_EMAIL=            # sandbox buyer that receives agent-fault payouts on test-card pool orders (judge mode)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
DATABASE_URL=
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=   # free key from aistudio.google.com/apikey
ANTHROPIC_API_KEY=            # only if LLM_PROVIDER=anthropic
LLM_DAILY_SPEND_CAP_USD=5
JUDGE_MODE=true
JUDGE_LOGIN_PASSWORD=
AG_STUDIO_LICENSE_KEY=
APP_BASE_URL=
PHASH_MATCH_THRESHOLD=16       # optional: photo-match distance, out of 256 bits
# spikes only (local): a sandbox personal buyer email, used by S6 payout
SPIKE_BUYER_EMAIL=
# optional: LLM token prices (USD per million tokens) for the daily cap; without them each call counts as $0.01
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
